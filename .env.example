# Copy to .env (never commit .env). Compose reads these values from here.

# LLM provider (Decision G): pluggable, deepseek is the default. Leave both
# provider keys empty to use the offline stub.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Set LLM_PROVIDER=anthropic to use Claude instead.
ANTHROPIC_API_KEY=
# Also doubles as the eval loop's LLM-as-judge key (services/data-agent/agent/eval_judge.py):
# the judge refuses to grade a model of its own family, so it only runs when
# ANTHROPIC_API_KEY is set and LLM_PROVIDER != anthropic. Otherwise `make eval`
# records G3 insight as skipped rather than faking a score.

# Optional — ships traces to Logfire Cloud. Since s32 W2 BOTH services are
# instrumented and the backend injects W3C traceparent on the agent hop, so one
# chat is one linked trace across them. Leave empty to trace locally only; no
# code changes needed either way.
LOGFIRE_TOKEN=

# --- Ops deck (s32) ---
# Machine token for POST /ops/ingest/* — the writers that record operational
# outcomes (k6 load tests, promptfoo red-team packs, deploys, pipeline runs).
# They post to backend-api because they cannot reach the database directly.
# EMPTY CLOSES THE ENDPOINT (404), which is the safe default; docker-compose sets
# a fixed dev value so `make loadtest` / `make redteam` work locally out of the
# box. In AWS, Terraform generates it into Secrets Manager.
# OPS_INGEST_TOKEN=dev-ops-token
#
# Tier-2 infra saturation on the deck (App Runner CPU/mem, Aurora ACU, CloudFront
# cache-hit) is one CloudWatch pull per rollup refresh. It needs AWS credentials
# and boto3, so it is off locally and enabled per-deployment with the Terraform
# variable `ops_cloudwatch_enabled` — which also attaches the IAM read grant.
# OPS_CLOUDWATCH_ENABLED=0

# Defaults below are baked into docker-compose.yml for local dev; override if needed.
# APP_ENV=dev
# AUTH_MODE=dev
# JWT_SECRET=dev-secret-change-me

# --- Google Sign-in (real auth) ---
# Leave AUTH_MODE=dev for the local stub. To use real Google login, set
# AUTH_MODE=google and fill these in (the backend validates ID tokens against
# Google's public JWKS — no client secret needed). The frontend picks up the
# client id automatically from GET /auth/config, so no rebuild. The OAuth client
# must be a Web client with http://localhost:5230 as an authorized JS origin.
# AUTH_MODE=google
# GOOGLE_CLIENT_ID=<oauth-2.0-web-client-id>.apps.googleusercontent.com
# ADMIN_EMAILS=you@gmail.com,teammate@gmail.com   # these emails map to the admin role
