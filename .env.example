# Copy to .env (never commit .env). Compose reads these values from here.

# LLM provider (Decision G): pluggable, deepseek is the default. Leave both
# provider keys empty to use the offline stub.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Set LLM_PROVIDER=anthropic to use Claude instead.
ANTHROPIC_API_KEY=
# Also doubles as the eval loop's LLM-as-judge key (services/data-agent/agent/eval_judge.py):
# the judge refuses to grade a model of its own family, so it only runs when
# ANTHROPIC_API_KEY is set and LLM_PROVIDER != anthropic. Otherwise `make eval`
# records G3 insight as skipped rather than faking a score.

# s45 agent_sdk runtime (challenger): AGENT_RUNTIME=agent_sdk switches the
# data-agent loop engine to the Claude Agent SDK on subscription auth.
# Generate the token with `claude setup-token` on the host. Local/dev only —
# there is no API-key prod path; prod stays demo mode.
AGENT_RUNTIME=pydantic_ai
CLAUDE_CODE_OAUTH_TOKEN=

# Optional — ships traces to Logfire Cloud. Since s32 W2 BOTH services are
# instrumented and the backend injects W3C traceparent on the agent hop, so one
# chat is one linked trace across them. Leave empty to trace locally only; no
# code changes needed either way.
LOGFIRE_TOKEN=

# Optional — self-hosted alternative/complement to Logfire Cloud (s37, now
# MLflow per s43). Both services export via OTLP/HTTP to whatever collector
# this points at; docker-compose defaults it to the local MLflow container
# (UI at :5500), so `make up` gives you a trace UI with no external account.
# Additive, not exclusive: set both this and LOGFIRE_TOKEN and spans go to
# both. Set to empty to turn self-hosted tracing off.
# OTLP_ENDPOINT=http://mlflow:5000

# --- Ops deck (s32) ---
# Machine token for POST /ops/ingest/* — the writers that record operational
# outcomes (k6 load tests, promptfoo red-team packs, deploys, pipeline runs).
# They post to backend-api because they cannot reach the database directly.
# EMPTY CLOSES THE ENDPOINT (404), which is the safe default; docker-compose sets
# a fixed dev value so `make loadtest` / `make redteam` work locally out of the
# box. In AWS, Terraform generates it into Secrets Manager.
# OPS_INGEST_TOKEN=dev-ops-token
#
# Tier-2 infra saturation on the deck (App Runner CPU/mem, Aurora ACU, CloudFront
# cache-hit) is one CloudWatch pull per rollup refresh. It needs AWS credentials
# and boto3, so it is off locally and enabled per-deployment with the Terraform
# variable `ops_cloudwatch_enabled` — which also attaches the IAM read grant.
# OPS_CLOUDWATCH_ENABLED=0

# --- Non-UI surfaces & service accounts (s35) ---
# Webhook and MCP callers authenticate with a service-account key (dpk_...)
# minted from Settings -> Service accounts (admin) or POST /admin/service-accounts;
# there is nothing to set here for them. Slack is different: it signs its own
# requests, verified against this workspace signing secret. EMPTY CLOSES the
# Slack endpoint (404); docker-compose sets a fixed dev value so the signature
# path is exercisable locally without a real Slack workspace.
# SLACK_SIGNING_SECRET=dev-slack-secret
#
# The standalone MCP server (services/mcp-server, :8200) calls backend-api with
# its own service key — mint one for surface="mcp" first, then set it here.
# Empty means the server starts but every tool reports it has no key rather
# than half-working.
# MCP_SERVICE_KEY=dpk_...
#
# Comma-separated Host values the MCP SDK's DNS-rebinding guard accepts (it
# matches the Host header INCLUDING the port; there is no wildcard/allow-all
# form). Defaults cover local compose; add your own hostname when deploying.
# MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,mcp-server:*,localhost,127.0.0.1,mcp-server

# Defaults below are baked into docker-compose.yml for local dev; override if needed.
# APP_ENV=dev
# AUTH_MODE=dev
# JWT_SECRET=dev-secret-change-me

# --- Job queue (s40-s42, optional local experiment) ---
# QUEUE_MODE=off keeps today's direct backend-api -> data-agent hop; "on"
# enqueues chat jobs to Redis Streams instead. `make queue-up` sets QUEUE_MODE=on
# for you — nothing here needs setting for a plain `make up`. REDIS_URL is fixed
# by docker-compose (redis://redis:6379/0) and not overridable here.
# QUEUE_MODE=off
# QUEUE_MAX_DEPTH=10          # admission bound; over this, /ask(/stream) sheds a 429
# JOB_DEADLINE_S=240          # rides in each job; a job past its deadline is abandoned
# WORKER_CONCURRENCY=1        # answer-slots per agent-worker process (1 = exact capacity math)
# PROM_HOST_PORT=9090         # obs profile: Prometheus UI
# GRAFANA_HOST_PORT=3000      # obs profile: Grafana (anonymous admin, local-only by design)

# --- Google Sign-in (real auth) ---
# Leave AUTH_MODE=dev for the local stub. To use real Google login, set
# AUTH_MODE=google and fill these in (the backend validates ID tokens against
# Google's public JWKS — no client secret needed). The frontend picks up the
# client id automatically from GET /auth/config, so no rebuild. The OAuth client
# must be a Web client with http://localhost:5230 as an authorized JS origin.
# AUTH_MODE=google
# GOOGLE_CLIENT_ID=<oauth-2.0-web-client-id>.apps.googleusercontent.com
# ADMIN_EMAILS=you@gmail.com,teammate@gmail.com   # these emails map to the admin role

# --- Slides/Sheets answers (s46) --------------------------------------------
# The agent answers into a Google Slides deck backed by a Google Sheet: native,
# editable charts the user can re-style, and a Sheet they can copy and extend.
#
# One generating account, DEV ONLY. Prod/demo deploys no data-agent service at
# all, so these are never set there and the deck tools are never even registered.
# Mint the refresh token once (--write-env updates this file in place, so the
# token never has to be copy-pasted anywhere):
#
#   GOOGLE_DECK_CLIENT_ID=... GOOGLE_DECK_CLIENT_SECRET=... \
#       uv run python scripts/google_auth.py --write-env
#
# The OAuth client here is a **Desktop app** client and is SEPARATE from the Web
# client used for sign-in above — different type, and this one has a secret.
# Hence the DECK_ prefix: sharing GOOGLE_CLIENT_ID between the two would break
# sign-in (the backend validates the ID-token audience against it).
# Scopes are drive.file + spreadsheets + presentations; deliberately not `drive`,
# which is a restricted scope requiring a security assessment.
# GOOGLE_DECK_CLIENT_ID=<desktop-app-client-id>.apps.googleusercontent.com
# GOOGLE_DECK_CLIENT_SECRET=<desktop-app-client-secret>
# GOOGLE_DECK_REFRESH_TOKEN=<from scripts/google_auth.py>
#
# A hand-built pack whose master carries named layouts. Empty = the built-in
# catalogue, so this works before any pack exists.
# GOOGLE_SLIDES_TEMPLATE_ID=
# s48 template packs. Both ids are written for you by
#   uv run --project services/data-agent python scripts/pack_scaffold.py --name nsw-property
# which also builds the two Google files and syncs packs/<name>/pack.json.
# GOOGLE_SHEET_TEMPLATE_ID=
# PACK_NAME=nsw-property
# PACK_DIR=packs
#
# DECK_EXPORT=1 registers the start_deck/add_slide tools (needs the three above).
# DECK_PUBLIC=1 shares each artifact anyone-with-link read-only. Kept as its own
# flag because that is the one call that puts a file outside RLS, and a public
# link cannot be un-published. Only enable where the data is genuinely public.
# DECK_EXPORT=1
# DECK_PUBLIC=0
# MAX_SLIDES=8

# --- MLOps plane (s43) -------------------------------------------------------
# MLflow server host port (container listens on 5000). 5500 by default because
# ConvFinQA-agent's MLflow owns 5000 on a shared dev machine.
# MLFLOW_HOST_PORT=5500
# Where the host-side scripts (make mlflow-init / register / promote, eval sink)
# find the tracking server. Match MLFLOW_HOST_PORT.
# MLFLOW_URL=http://localhost:5500
# OTLP spans route to this MLflow experiment (x-mlflow-experiment-id header).
# `make mlflow-init` creates data-qa/traces first => id 1 on a fresh store; it
# warns if yours differs. Set OTLP_ENDPOINT= (empty) to disable span export.
# MLFLOW_TRACE_EXPERIMENT_ID=1
# MLflow experiment that holds the eval loop's per-case runs (evals.py logs
# one run per case). Unset = the Evaluations tab hides the "mlflow case run"
# link rather than guessing an id.
# MLFLOW_EVALS_EXPERIMENT_ID=2
